            VALUE "FileDescription",  "DL Calc - Download Time, Speed & Size Calculator\0"
            VALUE "FileVersion",      "2.0.0.0\0"
            VALUE "InternalName",     "DLCalc.exe\0"
            VALUE "OriginalFilename", "DLCalc.exe\0"
            VALUE "ProductName",      "DL Calc\0"
            VALUE "ProductVersion",   "2.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
